{
    "name": "@repo/config-postgres",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "node-pg-migrate": "^8.0.4",
        "pg": "^8.22.0"
    },
    "devDependencies": {
        "@repo/config-typescript": "*",
        "@repo/config-eslint": "*",
        "@types/node-pg-migrate": "^2.3.1",
        "@types/pg": "^8.20.0",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.50.0"
    }
}