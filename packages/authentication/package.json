{
    "name": "@repo/authentication",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./client": {
            "types": "./dist/client/*.d.ts",
            "import": "./dist/client/*.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "clean": "rm -rf dist",
        "migrate": "node-pg-migrate -m db/migrations -s public -t authenicate_migrations",
        "migrate:create": "node-pg-migrate create -j sql -m db/migrations",
        "test": "node --env-file=.env --experimental-vm-modules node_modules/jest/bin/jest.js"
    },
    "dependencies": {
        "@repo/utility": "*",
        "@repo/config-postgres": "*",
        "@better-auth/infra": "^0.3.7",
        "better-auth": "^1.6.25"
    },
    "devDependencies": {
        "@repo/config-eslint": "*",
        "@repo/config-typescript": "*",
        "@types/node": "^22.20.1",
        "@types/jest": "^29.5.14",
        "jest": "^29.7.0",
        "ts-jest": "^29.3.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.2"
    }
}