{
    "name": "@repo/package",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "clean": "rm -rf dist",
        "test": "jest"
    },
    "dependencies": {
        "@repo/utility": "*"
    },
    "devDependencies": {
        "@repo/config-eslint": "*",
        "@repo/config-typescript": "*",
        "@types/node": "^22.20.1",
        "@types/jest": "^29.5.14",
        "jest": "^29.7.0",
        "ts-jest": "^29.3.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.2"
    }
}